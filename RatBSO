                ˗ˏˋ ꒰ ♡ ꒱ ˎˊ˗
"@

$f = New-Object System.Windows.Forms.Form
$f.FormBorderStyle = 'None'
$f.WindowState    = 'Maximized'
$f.TopMost        = $true
$f.BackColor      = [System.Drawing.Color]::FromArgb(255,213,79,210)
$f.ShowInTaskbar  = $false
$f.KeyPreview     = $true
$f.Add_KeyDown({ $_.SuppressKeyPress = $true })
$f.Add_FormClosing({ $_.Cancel = $true })

$a = New-Object System.Windows.Forms.Label
$a.ForeColor  = 'White'
$a.Font       = New-Object System.Drawing.Font('Consolas',20)
$a.AutoSize   = $false
$a.Dock       = 'Fill'
$a.TextAlign  = 'TopCenter'
